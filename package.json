{
  "name": "mcp-workspace-server",
  "version": "1.0.0",
  "description": "Sandboxed MCP file-server connector with git-lite, search and agent handoff protocol (CS3 Week 6 Midterms Pt 1)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
