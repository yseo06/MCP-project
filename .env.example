# Copy to .env and fill in. NEVER commit .env.
PORT=3000
# Absolute or relative path of the sandbox. Every tool path is resolved inside it.
WORKSPACE_ROOT=./workspace
# role:token pairs, comma separated. Roles: reader | worker | admin
# Generate tokens with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_TOKENS=admin:CHANGE_ME_admin_token_min16,worker:CHANGE_ME_worker_token_min16,reader:CHANGE_ME_reader_token_min16
# Where the JSONL call log is written
LOG_FILE=./logs/calls.jsonl
# Limits
MAX_FILE_BYTES=1000000
MAX_OUTPUT_CHARS=20000
